// sort_histogram - GPU radix sort pass A: 8-bit digit histogram.
// Each workgroup processes a 256-element tile of the key array and writes
// its 256-bin digit histogram to global_hist.
#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Keys { uint keys[]; };
layout(std430, binding = 1) buffer GlobalHist { uint global_hist[]; };
layout(std430, binding = 2) buffer Scanned { uint scanned[]; };
layout(std430, binding = 3) buffer PadA { uint pad_a[]; }; // unused, kept bound

layout(push_constant) uniform PC {
    uint n;      // element count
    uint shift;  // digit shift (0, 8, 16)
    uint groups; // number of workgroups
    uint pad;
} pc;

shared uint local_hist[256];

void main() {
    uint tid = gl_GlobalInvocationID.x;

    // Zero shared histogram
    local_hist[gl_LocalInvocationID.x] = 0;
    barrier();

    // Accumulate one element per thread for valid lanes
    if (tid < pc.n) {
        uint key = (keys[tid] >> pc.shift) & 0xFFu;
        atomicAdd(local_hist[key], 1u);
    }
    barrier();

    // Every workgroup writes every bin entry (0..255) into its row in global_hist.
    global_hist[gl_WorkGroupID.x * 256u + gl_LocalInvocationID.x] = local_hist[gl_LocalInvocationID.x];
}
