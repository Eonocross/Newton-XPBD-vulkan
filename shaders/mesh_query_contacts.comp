// mesh_query_contacts - GPU particle-vs-mesh narrowphase collision query.
// BVH traversal with distance pruning, closest-point on triangle,
// and angle-weighted pseudo-normal sign determination.
#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// particle positions (xyzw stride 4)
layout(std430, set = 0, binding = 0) readonly buffer Q { vec4 q[]; };
// particle radii
layout(std430, set = 0, binding = 1) readonly buffer Radii { float radii[]; };
// particle flags (int32, ACTIVE = 1)
layout(std430, set = 0, binding = 2) readonly buffer PFlags { int pflags[]; };
// mesh
layout(std430, set = 0, binding = 3) readonly buffer Vtx { float points[]; };  // 3*V
layout(std430, set = 0, binding = 4) readonly buffer Idx { uint tri_idx[]; };  // 3*T
layout(std430, set = 0, binding = 5) readonly buffer NodeLower { float nl_xyzw[]; };  // 4*N (x,y,z, i-as-float)
layout(std430, set = 0, binding = 6) readonly buffer NodeUpper { float nu_xyzw[]; };  // 4*N
layout(std430, set = 0, binding = 7) readonly buffer BvhMeta { uint bvh_meta[]; };  // [0]=root, [1]=node_count, [2]=leaf_size
layout(std430, set = 0, binding = 8) readonly buffer PrimIdx { uint prim[]; };
// mesh vertex/edge stats for epsilon: [0] = average_edge_length
layout(std430, set = 0, binding = 9) readonly buffer MeshProps { float mesh_props[]; };

// outputs (same SoA the solver consumes; plane generator writes the same)
layout(std430, set = 0, binding = 10) buffer OutCount { int out_count[]; };      // [1]
layout(std430, set = 0, binding = 11) buffer OutParticle { int out_particle[]; };
layout(std430, set = 0, binding = 12) buffer OutBodyPos { float out_body_pos[]; };  // packed vec3
layout(std430, set = 0, binding = 13) buffer OutNormal { float out_normal[]; };     // packed vec3
layout(std430, set = 0, binding = 14) readonly buffer Params { uint params[]; };  // [0]=n_particles, [1]=contact_max, [2]=margin_bits

const float PI = 3.14159265359f;

uint unpack_index(uint packed) {
    // node 'i' field: low 30 bits (we store plainly; no leaf bit in upper)
    return packed & 0x3FFFFFFFu;
}
uint unpack_leaf_flag(uint packed) {
    return (packed >> 30u) & 0x3u;
}

float dist_sq_aabb(vec3 p, vec3 lo, vec3 hi) {
    vec3 d = max(max(lo - p, vec3(0.0)), p - hi);
    return dot(d, d);
}

void closest_point_triangle(vec3 p, vec3 a, vec3 b, vec3 c, out vec3 cp, out vec3 tri_normal) {
    vec3 ab = b - a, ac = c - a, ap = p - a;
    float d1 = dot(ab, ap), d2 = dot(ac, ap);
    vec3 bp = p - b;
    float d3 = dot(ab, bp), d4 = dot(ac, bp);
    vec3 cpx = p - c;
    float d5 = dot(ab, cpx), d6 = dot(ac, cpx);
    float va = d3*d6 - d5*d4;
    float vb = d5*d2 - d1*d6;
    float vc = d1*d4 - d3*d2;
    float denom = va + vb + vc;
    tri_normal = normalize(cross(ab, ac));
    if (denom > 1e-12 && va >= 0.0 && vb >= 0.0 && vc >= 0.0) {
        float inv = 1.0 / denom;
        cp = a + (ab * vb + ac * vc) * inv;
        return;
    }
    // region order + predicates for stable tie-breaking
    if (d1 <= 0.0 && d2 <= 0.0) { cp = a; return; }
    if (d3 >= 0.0 && d4 <= d3)  { cp = b; return; }
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) { cp = a + ab * (d1 / (d1 - d3)); return; }
    if (d6 >= 0.0 && d5 <= d6)  { cp = c; return; }
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) { cp = a + ac * (d2 / (d2 - d6)); return; }
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) { cp = b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6))); return; }
    cp = b + (c - b) * (d5 / (d5 - d6));
}

void main() {
    uint n_particles = params[0];
    uint contact_max = params[1];
    float margin = uintBitsToFloat(params[2]);
    float avg_edge = mesh_props[0];
    float epsilon_min_dist = avg_edge * 1e-3;
    float eps2 = epsilon_min_dist * epsilon_min_dist;
    uint root = bvh_meta[0];
    uint leaf_size = bvh_meta[2];

    uint tid = gl_GlobalInvocationID.x;
    if (tid >= n_particles) return;
    if ((pflags[tid] & 1) == 0) return;

    vec3 p = q[tid].xyz;
    float radius = radii[tid];
    float max_dist = margin + radius;   
    float max_dist_eps = max_dist + epsilon_min_dist;

    // iterative DFS with pruning
    uint stack[32];
    uint sp = 0;
    stack[sp++] = root;
    float min_dist = max_dist_eps;
    vec3 best_cp = vec3(0.0);
    vec3 acc_normal = vec3(0.0);
    bool found = false;

    while (sp > 0) {
        uint ni = stack[--sp];
        vec3 lo = vec3(nl_xyzw[ni*4+0], nl_xyzw[ni*4+1], nl_xyzw[ni*4+2]);
        vec3 hi = vec3(nu_xyzw[ni*4+0], nu_xyzw[ni*4+1], nu_xyzw[ni*4+2]);
        float nds = dist_sq_aabb(p, lo, hi);
        if (nds > (min_dist + epsilon_min_dist) * (min_dist + epsilon_min_dist)) continue;

        uint lower_packed = floatBitsToUint(nl_xyzw[ni*4+3]);
        uint left_i = unpack_index(lower_packed);
        uint is_leaf = unpack_leaf_flag(lower_packed);
        uint right_i = unpack_index(floatBitsToUint(nu_xyzw[ni*4+3]));

        if (is_leaf != 0u) {
            for (uint pc = left_i; pc < right_i; pc++) {
                uint t = prim[pc];
                vec3 a = vec3(points[tri_idx[t*3+0]*3+0], points[tri_idx[t*3+0]*3+1], points[tri_idx[t*3+0]*3+2]);
                vec3 b = vec3(points[tri_idx[t*3+1]*3+0], points[tri_idx[t*3+1]*3+1], points[tri_idx[t*3+1]*3+2]);
                vec3 c = vec3(points[tri_idx[t*3+2]*3+0], points[tri_idx[t*3+2]*3+1], points[tri_idx[t*3+2]*3+2]);
                vec3 cp; vec3 tn;
                closest_point_triangle(p, a, b, c, cp, tn);
                float dist = length(cp - p);
                if (dist < min_dist + epsilon_min_dist) {
                    // angle-weighted contribution
                    vec3 e0 = b - a, e1 = c - a, e2 = c - b;
                    float weight;
                    vec3 cpv = cp - a, cqv = cp - b, crv = cp - c;
                    float lcp = dot(cpv, cpv), lcq = dot(cqv, cqv), lcr = dot(crv, crv);
                    float e0n2 = dot(e0, e0), e1n2 = dot(e1, e1), e2n2 = dot(e2, e2);
                    if (lcp < eps2)          weight = acos(dot(normalize(e0), normalize(e1)));
                    else if (lcq < eps2)     weight = acos(dot(normalize(e2), normalize(-e0)));
                    else if (lcr < eps2)     weight = acos(dot(normalize(-e1), normalize(-e2)));
                    else {
                        float e0cp = dot(e0, cpv), e2cq = dot(e2, cqv), e1cp = dot(e1, cpv);
                        if ((lcp*e0n2 - e0cp*e0cp < eps2*e0n2) ||
                            (lcq*e2n2 - e2cq*e2cq < eps2*e2n2) ||
                            (lcp*e1n2 - e1cp*e1cp < eps2*e1n2)) weight = PI;
                        else weight = 2.0 * PI;
                    }
                    // Every triangle within
                    // epsilon of the running min contributes (no near/far split)
                    acc_normal += weight * tn;
                    if (dist < min_dist) { min_dist = dist; best_cp = cp; }
                    found = true;
                }
            }
        } else {
            vec3 llo = vec3(nl_xyzw[left_i*4+0], nl_xyzw[left_i*4+1], nl_xyzw[left_i*4+2]);
            vec3 lhi = vec3(nu_xyzw[left_i*4+0], nu_xyzw[left_i*4+1], nu_xyzw[left_i*4+2]);
            vec3 rlo = vec3(nl_xyzw[right_i*4+0], nl_xyzw[right_i*4+1], nl_xyzw[right_i*4+2]);
            vec3 rhi = vec3(nu_xyzw[right_i*4+0], nu_xyzw[right_i*4+1], nu_xyzw[right_i*4+2]);
            float lds = dist_sq_aabb(p, llo, lhi);
            float rds = dist_sq_aabb(p, rlo, rhi);
            float thresh = (min_dist + epsilon_min_dist) * (min_dist + epsilon_min_dist);
            if (lds < rds) {
                if (rds < thresh) stack[sp++] = right_i;
                if (lds < thresh) stack[sp++] = left_i;
            } else {
                if (lds < thresh) stack[sp++] = left_i;
                if (rds < thresh) stack[sp++] = right_i;
            }
        }
    }

    if (!found || min_dist >= max_dist) return;
    float sign = dot(acc_normal, p - best_cp) > 0.0 ? 1.0 : -1.0;

    vec3 delta = p - best_cp;
    float delta_len = length(delta);
    vec3 nrm;
    if (delta_len > 1e-7) {
        nrm = (delta / delta_len) * sign;
    } else {
        float acc_len = length(acc_normal);
        if (acc_len > 1e-7) {
            nrm = (acc_normal / acc_len) * sign;
        } else {
            nrm = vec3(0.0, 0.0, 1.0);
        }
    }

    uint index = uint(atomicAdd(out_count[0], 1));
    if (index >= contact_max) return;
    out_particle[index] = int(tid);
    out_body_pos[index*3+0] = best_cp.x; out_body_pos[index*3+1] = best_cp.y; out_body_pos[index*3+2] = best_cp.z;
    out_normal[index*3+0] = nrm.x; out_normal[index*3+1] = nrm.y; out_normal[index*3+2] = nrm.z;
}
