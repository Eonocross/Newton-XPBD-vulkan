// integrate_particles - Particle time integration.
//
// Integration:
//   v1 = v0 + (f0 * inv_mass + gravity) * dt
//   v1 = clamp(v1, v_max)
//   x1 = x0 + v1 * dt
#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer X { vec4 x[]; };          // particle_q (xyz, pad)
layout(std430, binding = 1) readonly buffer V { vec4 v[]; };          // particle_qd (xyz, pad)
layout(std430, binding = 2) readonly buffer F { vec4 f[]; };          // external force (xyz, pad)
layout(std430, binding = 3) readonly buffer W { float w[]; };         // particle_inv_mass
layout(std430, binding = 4) readonly buffer Flags { int particle_flags[]; };
layout(std430, binding = 5) readonly buffer World { int particle_world[]; };
layout(std430, binding = 6) readonly buffer Gravity { vec4 gravity[]; }; // per-world gravity (xyz, pad)

layout(std430, binding = 7) writeonly buffer XNew { vec4 x_new[]; };
layout(std430, binding = 8) writeonly buffer VNew { vec4 v_new[]; };

layout(push_constant) uniform PC {
    float dt;
    float v_max;
    float _pad0;
    float _pad1;
} pc;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (tid >= uint(x.length())) return;

    vec3 x0 = x[tid].xyz;
    if ((particle_flags[tid] & 1) == 0) {   // ACTIVE bit
        x_new[tid] = vec4(x0, 0.0);
        return;
    }

    vec3 v0 = v[tid].xyz;
    vec3 f0 = f[tid].xyz;

    float inv_mass = w[tid];
    int world_idx = particle_world[tid];
    vec3 world_g = gravity[max(world_idx, 0)].xyz;

    // wp.step(-inv_mass) == float(inv_mass > 0)  — see header note (INVERTED vs GLSL step)
    float g_scale = inv_mass > 0.0 ? 1.0 : 0.0;
    vec3 v1 = v0 + (f0 * inv_mass + world_g * g_scale) * pc.dt;

    float v1_mag = length(v1);
    if (v1_mag > pc.v_max) v1 *= pc.v_max / v1_mag;

    vec3 x1 = x0 + v1 * pc.dt;

    x_new[tid] = vec4(x1, 0.0);
    v_new[tid] = vec4(v1, 0.0);
}
