// sort_scan - GPU radix sort pass B: prefix sum over workgroup histograms.
// Dispatched with 256 workgroups (one per bin: gl_WorkGroupID.x = bin).
// 256 threads per bin, chunked sum + shared-memory Hillis-Steele scan + chunked parallel rewrite.
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer GlobalHist { uint global_hist[]; };
layout(std430, binding = 1) buffer Scanned { uint scanned[]; };

layout(push_constant) uniform PC {
    uint n;
    uint shift;
    uint groups;
    uint pad;
} pc;

shared uint s_scan[2][256];

void main() {
    uint bin = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    uint chunk = (pc.groups + 255u) / 256u;
    uint g0 = min(lid * chunk, pc.groups);
    uint g1 = min(g0 + chunk, pc.groups);

    // A: sum this thread's chunk (independent loads, no stores)
    uint sum = 0u;
    for (uint g = g0; g < g1; g++) {
        sum += global_hist[g * 256u + bin];
    }

    // B: inclusive Hillis-Steele scan of the 256 chunk sums
    s_scan[0][lid] = sum;
    barrier();

    int src = 0;
    for (uint off = 1u; off < 256u; off <<= 1) {
        int dst = src ^ 1;
        s_scan[dst][lid] = (lid >= off) ? (s_scan[src][lid] + s_scan[src][lid - off])
                                        : s_scan[src][lid];
        barrier();
        src = dst;
    }

    uint running = (lid == 0u) ? 0u : s_scan[src][lid - 1u];
    if (lid == 255u) {
        scanned[bin] = s_scan[src][255];
    }

    // C: rewrite this chunk as an exclusive prefix
    for (uint g = g0; g < g1; g++) {
        uint idx = g * 256u + bin;
        uint c = global_hist[idx];
        global_hist[idx] = running;
        running += c;
    }
}
